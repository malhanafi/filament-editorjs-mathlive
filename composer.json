{
    "name": "malhanafi/filament-editorjs-mathlive",
    "description": "This is my package filament-editorjs-mathlive",
    "keywords": [
        "malhanafi",
        "laravel",
        "filament-editorjs-mathlive"
    ],
    "homepage": "https://github.com/malhanafi/filament-editorjs-mathlive",
    "support": {
        "issues": "https://github.com/malhanafi/filament-editorjs-mathlive/issues",
        "source": "https://github.com/malhanafi/filament-editorjs-mathlive"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "malhanafi",
            "email": "malhanafi@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0",
        "filament/forms": "^4.0",
        "filament/spatie-laravel-media-library-plugin": "^v4.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.11",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.1",
        "pestphp/pest-plugin-arch": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "pestphp/pest-plugin-livewire": "^2.1",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Malhanafi\\FilamentEditorjs\\": "src/",
            "Malhanafi\\FilamentEditorjs\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Malhanafi\\FilamentEditorjs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Malhanafi\\FilamentEditorjs\\FilamentEditorjsServiceProvider"
            ],
            "aliases": {
                "FilamentEditorjs": "Malhanafi\\FilamentEditorjs\\Facades\\FilamentEditorjs"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
